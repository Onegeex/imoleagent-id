# Copy to .env and fill in. NEVER commit .env.
# Meter's signing key: the private key printed by `cast wallet new` for 0x11d2DA9979F0caBceB8dBf0BE06AB83430622d93
DEVICE_KEY=0x...
# Relayer pays gas for usage reports. Leave RELAYER_KEY empty to use your Foundry keystore "deployer"
# (you'll be asked for its password at start).
RELAYER_KEY=
# Contract + meter
GRID=0x0e5D4530b91b6c18a7c9A7831Aa1c919d624150f
METER_LABEL=imole:ife-001
RPC_URL=https://bsc-dataseed.bnbchain.org
# Simulation: 60 W bulb; SPEED=60 makes 1 real minute = 1 hour of use (good for demos)
LOAD_W=60
SPEED=60
POLL_S=10
REPORT_S=120
